generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     String @default("user")
}

model Products {
  id        Int      @id @default(autoincrement())
  name      String
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
}

